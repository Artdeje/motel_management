# ============================================
# Motel Management System
# ============================================
# Copy to .env and fill values. Never commit .env.

# --- Local MySQL (XAMPP) — source for npm run db:seed-supabase ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=motel_management

# --- Supabase (production DB + health) ---
SUPABASE_URL=https://cnudfdpdyrplsqwmvolu.supabase.co
SUPABASE_ANON_KEY=
# Transaction pooler URI — required for deploy & MySQL→Supabase seed
# Dashboard → Database → Connect → Transaction pooler
SUPABASE_DB_URL=
DATABASE_URL=

# Browser (Vite only exposes VITE_*)
VITE_SUPABASE_URL=https://cnudfdpdyrplsqwmvolu.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Split deploy only: backend absolute URL. Leave empty on Railway fullstack.
VITE_API_URL=

# App
CURRENCY=RWF
CURRENCY_SYMBOL=Frw
APP_URL=https://yourdomain.com
APP_ENV=production
NODE_ENV=production
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# SMTP (OTP login emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Motel Management <noreply@yourdomain.com>"
