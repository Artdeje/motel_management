# MySQL Database (Railway provides these automatically when you add a MySQL plugin)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=motel_management

# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=your-secret-key-change-this

# SMTP (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
